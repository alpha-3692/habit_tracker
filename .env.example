# ============================================================
# HabitForge Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=development
APP_NAME=HabitForge
APP_VERSION=0.1.0

# ── Backend ─────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# ── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://habitforge_user:your_password_here@localhost:5432/habitforge_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Authentication ───────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=your_secret_key_here_generate_with_python_secrets_module
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# ── Google OAuth (future) ────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── AI / Claude API ──────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MAX_TOKENS=2048
AI_MODEL=claude-3-5-sonnet-20241022

# ── Payment Provider (future) ────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# STRIPE_PRICE_ID_PRO_MONTHLY=price_your_price_id_here

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Email (future) ───────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@habitforge.app
# SMTP_PASSWORD=your_smtp_password_here
# EMAIL_FROM=HabitForge <noreply@habitforge.app>

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FORMAT=json
