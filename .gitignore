# ============================================================
# HabitForge .gitignore
# ============================================================

# ── Environment & Secrets ───────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
*.pem
*.key
*.p12
*.pfx
secrets/

# ── Python / Backend ────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
cover/

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
backend/.venv/
backend/venv/

# ── Node / Frontend ─────────────────────────────────────────
node_modules/
frontend/node_modules/
.npm
.eslintcache
.stylelintcache
*.tsbuildinfo
next-env.d.ts
.next/
out/
frontend/.next/
frontend/out/
frontend/dist/
frontend/build/

yarn.lock
pnpm-lock.yaml
.yarn/
.pnp.*

# ── Database ────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
postgres-data/

# ── IDE / Editors ───────────────────────────────────────────
.idea/
.vscode/settings.json
.vscode/*.code-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Testing ─────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage/
frontend/coverage/

# ── Docker ──────────────────────────────────────────────────
docker-data/
